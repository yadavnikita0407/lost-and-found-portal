# Port (Render sets this dynamically via $PORT, defaults to 10000 on Render)
PORT=5000

# MongoDB Atlas Connection String
# Can use MONGO_URI or MONGODB_URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lostfound?retryWrites=true&w=majority

# Security & JWT
JWT_SECRET=super_secret_jwt_random_string_min_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary Storage for Item Photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Client URL(s) for CORS (comma-separated or single URL)
# Example: https://lost-and-found-portal.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Environment (development or production)
NODE_ENV=development

# Storage mode: 'cloudinary' or 'local'
STORAGE=cloudinary
